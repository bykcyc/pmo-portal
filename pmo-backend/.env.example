# Local development settings for pmo-backend. Copy to pmo-backend/.env (never commit .env).
# Everything here is optional for local development: without this file the portal runs with
# dev defaults, integrations switched off and e-mails kept in the outbox instead of being sent.
# Production settings live in deploy/.env.prod.example.

# Signs session tokens and encrypts stored secrets. The dev default is public — production
# refuses to start with it (and with a secret shorter than 32 bytes).  openssl rand -base64 32
ADAPTER_SECRET=

# Base URL used in links inside e-mails and Bitrix24 tasks.
PORTAL_PUBLIC_URL=http://localhost:3000

# ── Bitrix24 (optional) ────────────────────────────────────────────────
# Outgoing REST webhook, e.g. https://your-portal.bitrix24.com/rest/1/xxxxxxxxxxxx/
BITRIX24_WEBHOOK_URL=
BITRIX24_DEFAULT_RESPONSIBLE_ID=1
# Token the inbound Bitrix24 webhook sends in application_token (required in production
# whenever BITRIX24_WEBHOOK_URL is set).
BITRIX24_INBOUND_TOKEN=

# ── Fireflies.ai meeting notes (optional, off by default) ──────────────
FIREFLIES_ENABLED=
FIREFLIES_API_KEY=
# The "Signing Secret" of the Fireflies V2 webhook.  openssl rand -hex 32
FIREFLIES_WEBHOOK_SECRET=
FIREFLIES_BITRIX_COMMENTS=
# Comma-separated allow-lists (empty = no restriction).
FIREFLIES_ALLOWED_PROJECTS=
FIREFLIES_ALLOWED_HOSTS=
FIREFLIES_EXTRA_BITRIX_USERS=

# ── E-mail (optional) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# ── Tuning (defaults shown) ────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=10
WORKLOAD_OVERLOAD_TASKS=8
WORKLOAD_OVERLOAD_HOURS=80
WORKLOAD_OVERLOAD_PM_PROJECTS=4
# Protects /metrics; without it /metrics is closed in production.
METRICS_TOKEN=
