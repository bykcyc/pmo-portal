# Скопировать в .env на сервере и заполнить. Файл НЕ коммитить.

# ── домен и сертификат ────────────────────────────────────────────────
DOMAIN=pm.example.com
ACME_EMAIL=admin@example.com

# ── база ──────────────────────────────────────────────────────────────
POSTGRES_USER=pmo
POSTGRES_DB=pmo
# openssl rand -base64 24
POSTGRES_PASSWORD=

# ── бэкенд ────────────────────────────────────────────────────────────
# Подписывает сессионные токены. ОБЯЗАТЕЛЕН: при дефолте прод не стартует.
# openssl rand -base64 32
ADAPTER_SECRET=

# ── Bitrix24 (необязательно) ──────────────────────────────────────────
# Исходящий вебхук Bitrix (создание задач исполнителям):
BITRIX24_WEBHOOK_URL=
BITRIX24_DEFAULT_RESPONSIBLE_ID=1
# Если BITRIX24_WEBHOOK_URL задан — этот токен ОБЯЗАТЕЛЕН (иначе прод не стартует):
# входящий вебхук Bitrix должен слать его в application_token.
BITRIX24_INBOUND_TOKEN=

# ── Fireflies: протоколы встреч → совещание PMO + комментарий Битрикса (необязательно) ──
# Выключено по умолчанию. При FIREFLIES_ENABLED=1 ключ и секрет ОБЯЗАТЕЛЬНЫ (иначе прод не
# стартует). Секрет — тот же, что «Signing Secret» вебхука V2 в Fireflies (openssl rand -hex 32).
FIREFLIES_ENABLED=
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=
# Комментарии к событиям Битрикса — только когда на портале есть custom.calendar.comment.add.
FIREFLIES_BITRIX_COMMENTS=
# Ограничения через запятую (пусто = без ограничений): id проектов PMO, email владельцев встреч
# в Fireflies; доп. id пользователей Битрикса, в чьих календарях тоже искать событие.
FIREFLIES_ALLOWED_PROJECTS=
FIREFLIES_ALLOWED_HOSTS=
FIREFLIES_EXTRA_BITRIX_USERS=

# ── почта (необязательно; без неё письма копятся в OUTBOX) ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
