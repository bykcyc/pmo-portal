# Единственная точка входа: авто-HTTPS (Let's Encrypt), статика SPA и прокси к бэкенду.
# Для локальной проверки DOMAIN=localhost — Caddy отдаёт по HTTP без сертификата.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Потолок тела — на КАЖДОМ пути к бэкенду, а не только на /api: вебхуки, OAuth и точка
	# помощника открыты анонимам, и без потолка любой мог лить в бэкенд сколько угодно.
	# Новый блок с reverse_proxy без request_body уронит тест
	# pmo-backend/tests/test_log_redaction.py.

	# Фронт ходит в API строго через префикс /api (axios baseURL). handle_path срезает его,
	# как это делал vite-proxy в разработке.
	handle_path /api/* {
		request_body {
			max_size 26MB
		}
		reverse_proxy pmo-backend:8002
	}

	# Вебхук Fireflies: тело V2 — пять коротких полей, бэкенд режет на 64 КиБ. Потолок и здесь,
	# чтобы анонимный поток не доходил до бэкенда. Отдельный блок (Caddy выбирает более точный
	# путь раньше /webhooks/*), у вебхука Битрикса ниже — свой потолок.
	handle /webhooks/fireflies {
		request_body {
			max_size 64KB
		}
		reverse_proxy pmo-backend:8002
	}

	# Входящий вебхук Bitrix24 (без префикса, адрес задаётся в самом Bitrix). Настоящее тело —
	# десяток коротких полей формы; бэкенд режет там же, на 64 КиБ.
	handle /webhooks/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy pmo-backend:8002
	}

	# Точка подключения помощника (MCP). Без этого блока адрес уходил бы в SPA и клиент
	# получал бы index.html вместо протокола. flush_interval -1 — поток ответа идёт по SSE,
	# буферизация превратила бы его в зависший запрос. 4 МБ — с запасом на самый большой
	# черновик (300 элементов) и план нового проекта.
	handle /mcp* {
		request_body {
			max_size 4MB
		}
		reverse_proxy pmo-backend:8002 {
			flush_interval -1
		}
	}

	# OAuth для подключения помощника: метаданные, регистрация клиента, обмен кода.
	# Разговаривает с ними программа-клиент, поэтому всё уходит на бэкенд. Страница согласия
	# (/connect) сюда НЕ попадает — она часть SPA и обслуживается общим правилом ниже.
	# Тела здесь — короткие формы и JSON регистрации клиента.
	handle /.well-known/oauth-* {
		request_body {
			max_size 16KB
		}
		reverse_proxy pmo-backend:8002
	}
	handle /oauth/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy pmo-backend:8002
	}

	# SPA: любой неизвестный путь отдаёт index.html (роутинг на клиенте).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Токен публичной ссылки — это и есть доступ: он стоит в пути (/public/<токен>) и в
		# ?share=<токен> на каждом запросе публичной страницы, а браузер повторяет адрес страницы
		# в Referer каждого её запроса. В журнал — без значения; ?token= — старый способ метрик.
		# Шаблон — тот же, что в pmo-backend/security.py (_SECRET_IN_URL): меняете один — меняйте
		# и другой (их равенство проверяет тест).
		format filter {
			request>uri regexp "(/public/)[^/?#]+|([?&](?:share|token)=)[^&#]*" "${1}${2}REDACTED"
			request>headers>Referer regexp "(/public/)[^/?#]+|([?&](?:share|token)=)[^&#]*" "${1}${2}REDACTED"
		}
	}
}
