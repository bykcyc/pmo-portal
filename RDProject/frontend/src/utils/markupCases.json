      "out": "2 * 3 = 6 и курсив"
    },
    {
      "in": "В расчёте 5 * 4 и ещё 6 * 7 итого",
      "out": "В расчёте 5 * 4 и ещё 6 * 7 итого"
    },
    {
      "in": "some_var*2 и файл*.txt",
      "out": "some_var*2 и файл*.txt"
    },
    {
      "in": "шаг 1 * шаг 2 * шаг 3",
      "out": "шаг 1 * шаг 2 * шаг 3"
    },
    {
      "in": "(*важное*) и «*тоже*»",
      "out": "(важное) и «тоже»"
    },
    {
      "in": "текст *важно* и ещё",
      "out": "текст важно и ещё"
